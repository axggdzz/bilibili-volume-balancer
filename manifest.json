{
  "manifest_version": 3,
  "name": "B站音量均衡器",
  "short_name": "B站音量均衡",
  "version": "0.1.0",
  "description": "自动测量 B 站视频响度，把忽大忽小的视频音量拉齐；只在本机处理，不上传数据。",
  "permissions": ["storage"],
  "host_permissions": ["https://*.bilibili.com/*"],
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/video/*",
        "https://www.bilibili.com/list/*",
        "https://www.bilibili.com/medialist/play/*"
      ],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/loudness-worklet.js"],
      "matches": ["https://*.bilibili.com/*"]
    }
  ],
  "action": {
    "default_title": "B站音量均衡器",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
